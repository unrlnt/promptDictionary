# Copy to `.env.local` (gitignored) and fill in real values.
# Only browser-safe, anon-level values belong here — both are NEXT_PUBLIC_*.
# NEVER put the Supabase SECRET key (sb_secret_...) in web/. It is server-only and
# Supabase blocks it in the browser; the web app must only ever use the publishable key.

# Supabase project URL (EU region).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key (sb_publishable_...). Anon-level, safe to ship to the browser.
# Supabase dashboard: Project Settings → API Keys → Publishable key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key
