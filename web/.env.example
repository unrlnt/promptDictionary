# Copy to `.env.local` (gitignored) and fill in real values.
# Only browser-safe, anon-level values belong here — both are NEXT_PUBLIC_*.
# NEVER put the Supabase SECRET key (sb_secret_...) in web/. It is server-only and
# Supabase blocks it in the browser; the web app must only ever use the publishable key.

# Supabase project URL (EU region).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key (sb_publishable_...). Anon-level, safe to ship to the browser.
# Supabase dashboard: Project Settings → API Keys → Publishable key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key

# Base URL of the FastAPI engine service (promptdict.api). Local dev default below.
NEXT_PUBLIC_API_URL=http://localhost:8000

# OAuth (Google / Microsoft "azure") sign-in: NO provider secrets belong here.
# Client IDs/secrets are configured in the Supabase dashboard under
# Authentication → Providers (Google, Azure), not in the web app. The browser
# only ever uses the two NEXT_PUBLIC_* values above. The provider redirect/callback
# URL to register in each provider + Supabase is: https://<your-app>/auth/callback
