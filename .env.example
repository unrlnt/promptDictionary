# Copy to `.env` and fill in real values. `.env` is gitignored — never commit it.
# All values below are placeholders, not real credentials.

# Supabase project URL (Postgres + pgvector + auth), EU region.
SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key — safe for client/browser use; RLS enforces per-owner access.
SUPABASE_ANON_KEY=your-supabase-anon-key

# Server/worker secret key (new Supabase API keys). Supersedes the legacy
# service-role key below; bypasses RLS. SERVER / WORKER ONLY — Supabase blocks this
# key in the browser. Prefer this; the legacy var is only a transition fallback.
SUPABASE_SECRET_KEY=sb_secret_your-supabase-secret-key

# Legacy service-role key — still works as a fallback if SUPABASE_SECRET_KEY is unset.
# Also bypasses RLS; SERVER / WORKER ONLY, never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Mistral API key — covers both embeddings (mistral-embed) and extraction (Mistral Small).
MISTRAL_API_KEY=your-mistral-api-key

# Postgres connection string for direct DB access (e.g. scripts/db_check.py, worker).
# Supabase: Project Settings → Database → Connection string (URI). Server-side only.
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres
