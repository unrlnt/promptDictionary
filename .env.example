# Copy to `.env` and fill in real values. `.env` is gitignored — never commit it.
# All values below are placeholders, not real credentials.

# Supabase project URL (Postgres + pgvector + auth), EU region.
SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key — safe for client/browser use; RLS enforces per-owner access.
SUPABASE_ANON_KEY=your-supabase-anon-key

# Service-role key — bypasses RLS. SERVER / WORKER ONLY, never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Mistral API key — covers both embeddings (mistral-embed) and extraction (Mistral Small).
MISTRAL_API_KEY=your-mistral-api-key
